# MongoDB Atlas connection string.
# Get it from Atlas → Database → Connect → Drivers.
# Include the database name in the path (…/marker?…).
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/marker?retryWrites=true&w=majority"

# Secret for signing QuickTalk session cookies (any long random string)
SESSION_SECRET=""

# Super-admin account. The password is hashed before being stored in MongoDB.
SUPER_ADMIN_USERNAME="superadmin@abhy.com"
SUPER_ADMIN_PASSWORD="choose-a-private-password"
